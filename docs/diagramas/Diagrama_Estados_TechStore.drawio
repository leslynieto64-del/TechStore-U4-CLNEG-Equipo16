<mxfile host="drawio" agent="TechStore U4" version="32.4.1"><diagram id="techstore-estados" name="Máquina de estados"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1056" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Máquina de estados del pedido TechStore&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#44546A&quot;&gt;clase &lt;i&gt;Order&lt;/i&gt; · app/domain.py&lt;br&gt;notación: &lt;b&gt;operación()&lt;/b&gt; &lt;i&gt;[condición]&lt;/i&gt; / &lt;font color=&quot;#C55A11&quot;&gt;evento registrado&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=24;fontColor=#1F4D78;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="80" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#1F4D78;strokeColor=#1F4D78;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="154" y="112" width="32" height="32" as="geometry"/></mxCell><mxCell id="DRAFT" value="DRAFT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DEEAF6;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4D78;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="180" height="62" as="geometry"/></mxCell><mxCell id="CONFIRMED" value="CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DEEAF6;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4D78;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="180" height="62" as="geometry"/></mxCell><mxCell id="SHIPPED" value="SHIPPED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DEEAF6;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4D78;" vertex="1" parent="1"><mxGeometry x="80" y="550" width="180" height="62" as="geometry"/></mxCell><mxCell id="DELIVERED" value="DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#BDD7EE;strokeColor=#2E74B5;strokeWidth=3;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4D78;" vertex="1" parent="1"><mxGeometry x="80" y="740" width="180" height="62" as="geometry"/></mxCell><mxCell id="CANCELLED" value="CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#BDD7EE;strokeColor=#2E74B5;strokeWidth=3;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4D78;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="190" height="62" as="geometry"/></mxCell><mxCell id="RETURNED" value="RETURNED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#BDD7EE;strokeColor=#2E74B5;strokeWidth=3;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4D78;" vertex="1" parent="1"><mxGeometry x="560" y="550" width="190" height="62" as="geometry"/></mxCell><mxCell id="end1" value="" style="ellipse;html=1;shape=endState;fillColor=#1F4D78;strokeColor=#1F4D78;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="154" y="850" width="32" height="32" as="geometry"/></mxCell><mxCell id="end2" value="" style="ellipse;html=1;shape=endState;fillColor=#1F4D78;strokeColor=#1F4D78;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="800" y="375" width="32" height="32" as="geometry"/></mxCell><mxCell id="end3" value="" style="ellipse;html=1;shape=endState;fillColor=#1F4D78;strokeColor=#1F4D78;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="800" y="565" width="32" height="32" as="geometry"/></mxCell><mxCell id="e_start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4D78;strokeWidth=1.5;" edge="1" parent="1" source="start" target="DRAFT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t_confirm" value="&lt;b&gt;confirm()&lt;/b&gt;&lt;br&gt;&lt;i&gt;[al menos 1 artículo y cliente activo]&lt;/i&gt;&lt;br&gt;/ &lt;font color=&quot;#C55A11&quot;&gt;OrderConfirmed&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="DRAFT" target="CONFIRMED"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="t_ship" value="&lt;b&gt;ship(tracking_number)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[número de guía no vacío]&lt;/i&gt;&lt;br&gt;/ &lt;font color=&quot;#C55A11&quot;&gt;OrderShipped&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="CONFIRMED" target="SHIPPED"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t_deliver" value="&lt;b&gt;deliver()&lt;/b&gt;&lt;br&gt;/ &lt;font color=&quot;#C55A11&quot;&gt;OrderDelivered&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="SHIPPED" target="DELIVERED"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t_cancel" value="&lt;b&gt;cancel(reason)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[motivo no vacío]&lt;/i&gt;&lt;br&gt;/ &lt;font color=&quot;#C55A11&quot;&gt;OrderCancelled&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="CONFIRMED" target="CANCELLED"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-40" as="offset"/></mxGeometry></mxCell><mxCell id="t_return" value="&lt;b&gt;return_order()&lt;/b&gt;&lt;br&gt;/ &lt;font color=&quot;#C55A11&quot;&gt;OrderReturned&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#2E74B5;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="SHIPPED" target="RETURNED"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="e_end1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4D78;strokeWidth=1.5;" edge="1" parent="1" source="DELIVERED" target="end1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_end2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4D78;strokeWidth=1.5;" edge="1" parent="1" source="CANCELLED" target="end2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_end3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4D78;strokeWidth=1.5;" edge="1" parent="1" source="RETURNED" target="end3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_draft" value="&lt;b&gt;DRAFT&lt;/b&gt; (estado inicial)&lt;br&gt;• Único estado que admite &lt;b&gt;add_item()&lt;/b&gt;: máximo &lt;b&gt;20 unidades&lt;/b&gt; por pedido (suma de cantidades), precio en MXN.&lt;br&gt;• Sin artículos o con cliente inactivo, &lt;b&gt;confirm()&lt;/b&gt; lanza &lt;i&gt;InvalidOrderData&lt;/i&gt; (HTTP 422)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#BF9000;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="116" width="520" height="104" as="geometry"/></mxCell><mxCell id="n_conf" value="&lt;b&gt;CONFIRMED&lt;/b&gt;&lt;br&gt;• Sin guía, &lt;b&gt;ship()&lt;/b&gt; lanza &lt;i&gt;InvalidOrderData&lt;/i&gt; (422): sigue en CONFIRMED y no se registra &lt;i&gt;OrderShipped&lt;/i&gt;.&lt;br&gt;• Sin motivo, &lt;b&gt;cancel()&lt;/b&gt; lanza &lt;i&gt;InvalidOrderData&lt;/i&gt; (422)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#BF9000;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="520" height="96" as="geometry"/></mxCell><mxCell id="n_ship" value="&lt;b&gt;SHIPPED&lt;/b&gt;&lt;br&gt;• Solo admite &lt;b&gt;deliver()&lt;/b&gt; o &lt;b&gt;return_order()&lt;/b&gt;.&lt;br&gt;• &lt;b&gt;cancel()&lt;/b&gt; lanza &lt;i&gt;InvalidOrderTransition&lt;/i&gt; (409): sigue en SHIPPED y no se registra &lt;i&gt;OrderCancelled&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#BF9000;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="760" width="520" height="96" as="geometry"/></mxCell><mxCell id="n_rules" value="&lt;b&gt;Reglas comunes&lt;/b&gt;&lt;br&gt;• Cada transición válida sigue este orden: 1) valida las precondiciones, 2) cambia el estado y 3) registra el evento.&lt;br&gt;• Cualquier intento de ejecutar una operación de transición desde un estado no permitido (por ejemplo, confirmar dos veces o cancelar un pedido enviado) lanza &lt;i&gt;InvalidOrderTransition&lt;/i&gt; (HTTP 409), sin cambiar el estado ni registrar eventos.&lt;br&gt;• DELIVERED, RETURNED y CANCELLED son estados finales." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#BF9000;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="810" height="126" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>